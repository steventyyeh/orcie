#!/bin/bash
# orcie CLI (POC). Usage: orcie create|ls|send|dm|log|shell|rm ...
S="${ORCIE_SERVER:-http://127.0.0.1:8080}"
j() { curl -s -H 'content-type: application/json' "$@"; echo; }
enc() { node -e 'console.log(JSON.stringify(Object.fromEntries(process.argv.slice(1).map(a=>a.split(/=(.*)/s).slice(0,2)))))' "$@"; }
case "$1" in
  create) j -X POST "$S/agents" -d "$(enc name="$2" ${3:+model="$3"})" ;;
  ls) j "$S/agents" ;;
  send) j -X POST "$S/dm" -d "$(enc from=user to="$2" text="$3")" ;;
  dm) # operator acting as agent <from>: signs with the server secret (the agent listener derives the sender from the token)
    T=$(node -e 'const c=require("crypto");const s=require("fs").readFileSync(process.env.HOME+"/.orcie/server-secret","utf8").trim();console.log(c.createHmac("sha256",s).update("orcie-agent:"+process.argv[1]).digest("hex"))' "$2")
    curl -s -H 'content-type: application/json' -H "Authorization: Bearer $T" -X POST "${ORCIE_AGENT_SERVER:-http://127.0.0.1:8081}/dm" -d "$(enc to="$3" text="$4")"; echo ;;
  log) curl -s "$S/agents/$2/log" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).log.forEach(t=>console.log(`\n[${t.at}] ${t.from}: ${t.text}\n  -> ${t.reply}`)))' ;;
  shell) docker exec -it "orcie-$2" bash ;;
  search) curl -s "$S/api/search?q=$(node -e 'console.log(encodeURIComponent(process.argv[1]))' "$2")" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).results.forEach(r=>console.log(`${r.title} #${r.seq} ${r.from}: ${r.snippet.replace(/\[\[|\]\]/g,"*").replace(/\n/g," ")}`)))' ;;
  doctor) curl -s "$S/api/git?verify=1" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);console.log("git token file:",j.tokenFile?"present":"MISSING");let bad=0;j.agents.forEach(a=>{const ok=a.ok;if(!ok)bad++;console.log(`  ${a.name.padEnd(10)} mounted=${a.mounted} github=${a.githubUser||"NO ACCESS"}${ok?"":"   <- run: orcie recreate "+a.name}`)});(j.external||[]).forEach(n=>console.log(`  ${n.padEnd(10)} external agent (no container, not given the token)`));process.exit(bad?1:0)})' ;;
  link-tmux) j -X POST "$S/agents/tmux" -d "$(enc name="$2" session="$3")" ;;
  tmux-sessions) j "$S/api/tmux" ;;
  add-external) j -X POST "$S/agents/external" -d "$(enc name="$2")" ;;
  recreate) j -X POST "$S/api/agents/$2/recreate" ;;
  recreate-all) for a in $(curl -s "$S/agents" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).forEach(a=>console.log(a.name)))'); do echo -n "$a: "; j -X POST "$S/api/agents/$a/recreate" | head -c 80; echo; done ;;
  rm) echo "orcie rm was removed. Use: orcie layoff <agent>   (asks you to type the agent's name; in scripts: --confirm <agent>)"; exit 1 ;;
  layoff) # deletes the container and volume, keeps all conversation history. Saves a workspace archive first unless --no-archive.
    ag="$2"; [ -n "$ag" ] || { echo "usage: orcie layoff <agent> [--confirm <agent>] [--no-archive]"; exit 1; }; conf=""; arch=1
    shift 2; while [ $# -gt 0 ]; do case "$1" in --confirm) conf="$2"; shift 2 ;; --no-archive) arch=0; shift ;; *) echo "unknown option $1"; exit 1 ;; esac; done
    if [ -z "$conf" ]; then printf 'This lays off "%s": container, volume and room membership are deleted. Conversation history is kept.%s\nType the agent name to confirm: ' "$ag" "$([ $arch = 1 ] && echo ' A workspace archive is saved first.')"; read -r conf; fi
    [ "$conf" = "$ag" ] || { echo "cancelled: the confirmation did not match the agent name"; exit 1; }
    j -X DELETE "$S/agents/$ag?confirm=$conf&archive=$arch" ;;
  drop-backup) # frees the old unlimited volume kept after a disk migration (the agent now runs on its limited volume)
    ag="$2"; [ -n "$ag" ] || { echo "usage: orcie drop-backup <agent> [--confirm <agent>]"; exit 1; }; conf=""; [ "$3" = "--confirm" ] && conf="$4"
    if [ -z "$conf" ]; then printf 'Delete the old backup volume orcie-%s-data? The agent keeps running on its limited volume.\nType the agent name to confirm: ' "$ag"; read -r conf; fi
    [ "$conf" = "$ag" ] || { echo "cancelled"; exit 1; }; j -X DELETE "$S/api/agents/$ag/backup?confirm=$conf" ;;
  set) # resources and model: orcie set <agent> [--cpu 2] [--memory 4g] [--disk 20g] [--model id] [--restart-ok]
    ag="$2"; [ -n "$ag" ] || { echo "usage: orcie set <agent> [--cpu N] [--memory 4g] [--disk 20g] [--model id] [--restart-ok]"; exit 1; }; shift 2
    body=$(node -e '
      const a=process.argv.slice(1),o={};const sz=(v,u)=>{const m=String(v).toLowerCase().match(/^(\d+(?:\.\d+)?)\s*(k|m|g|t)?b?$/);if(!m){console.error("cannot read size "+v);process.exit(2)}return Number(m[1])*({k:1/1024,m:1,g:1024,t:1048576}[m[2]||"g"])/(u==="gb"?1024:1)};
      for(let i=0;i<a.length;i+=2){const k=a[i],v=a[i+1];if(k==="--cpu")o.cpus=Number(v);else if(k==="--memory")o.memoryMb=Math.round(sz(v,"mb"));else if(k==="--disk")o.diskGb=sz(v,"gb");else if(k==="--model")o.model=v;else if(k==="--restart-ok"){o.confirmRestart=true;i--}else{console.error("unknown option "+k);process.exit(2)}}
      console.log(JSON.stringify(o))' -- "$@") || exit 1
    out=$(curl -s -X POST "$S/api/agents/$ag/resources" -H 'content-type: application/json' -d "$body")
    echo "$out" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);if(j.error){console.log("error: "+j.error);if(j.needsRestart){console.log("This needs a restart of the agent (same volume, nothing is lost):");j.needsRestart.forEach(x=>console.log("  - "+x));console.log(j.busy?"The agent is busy; try again when it is idle.":"Run again with --restart-ok to apply.")}process.exit(1)}
      const r=j.res,u=j.usage||{};console.log(`${j.name}: model ${j.model}, ${r.cpus} CPU, ${r.memoryMb/1024} GB memory, ${r.diskGb==null?"no disk limit":r.diskGb+" GB disk"}${j.restarted?" (restarted on the same volume)":""}`);(j.warnings||[]).forEach(w=>console.log("warning: "+w))})' ;;
  check) # in-container checks: tools, auth, browser, GitHub, image, server reachability
    curl -s "$S/api/check${2:+?agent=$2}" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);let bad=0;for(const a of j.agents){console.log(a.agent+(a.ok?"  OK":"  PROBLEMS"));for(const c of a.checks){if(!c.ok)bad++;console.log("  "+(c.ok?"ok  ":"FAIL")+" "+c.name.padEnd(10)+c.detail)}}process.exit(bad?1:0)})' ;;
  stats) curl -s "$S/api/stats" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s),g=b=>(b/2**30).toFixed(1)+"G";console.log("agent".padEnd(14)+"kind".padEnd(10)+"busy".padEnd(6)+"convs".padEnd(7)+"sent".padEnd(7)+"promises".padEnd(10)+"cpu".padEnd(14)+"memory".padEnd(26)+"disk");
      for(const a of j.agents){const l=a.limits,cpu=a.cpu?`${a.cpu}/${l?l.cpus:"-"}`:"-";const dsk=l?(l.diskGb==null?(a.diskUsedBytes!=null?g(a.diskUsedBytes)+" (no limit)":"no limit"):(a.diskUsedBytes!=null?`${g(a.diskUsedBytes)} / ${l.diskGb}G (${Math.round(a.diskUsedBytes/a.diskSizeBytes*100)}%)`:`- / ${l.diskGb}G`)):"-";
        console.log(a.name.padEnd(14)+a.kind.padEnd(10)+String(a.busy).padEnd(6)+String(a.conversations).padEnd(7)+String(a.messagesSent).padEnd(7)+String(a.activePromises).padEnd(10)+cpu.padEnd(14)+String(a.memory??"-").padEnd(26)+dsk)}})' ;;
  logs) docker logs --tail "${3:-100}" "orcie-$2" ;;
  attach) # chat with an agent from the terminal (Ctrl-D to leave)
    [ -n "$2" ] || { echo "usage: orcie attach <agent>"; exit 1; }; echo "chatting with $2 (Ctrl-D to leave)"
    while printf '%s> ' "you"; IFS= read -r line; do [ -z "$line" ] && continue; echo "...thinking"; curl -s -X POST "$S/dm" -H 'content-type: application/json' -d "$(enc to="$2" text="$line")" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);console.log("\n"+"'"$2"'"+"> "+(j.reply??j.error??"(no reply)")+"\n")})'; done; echo ;;
  promises) curl -s "$S/api/promises${2:+?agent=$2}" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).promises.forEach(p=>console.log(`#${p.id} ${p.agent} [${p.status}] ${p.text}`)))' ;;
  restart) # restart agent processes; waits until the agent is idle unless --force
    force=0; names=(); for a in "${@:2}"; do [ "$a" = "--force" ] && force=1 || names+=("$a"); done
    if [ "${names[0]}" = "--all" ] || [ ${#names[@]} -eq 0 ]; then names=($(curl -s "$S/agents" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).filter(a=>!a.kind||a.kind==="claude").forEach(a=>console.log(a.name)))')); fi
    for a in "${names[@]}"; do
      if [ $force -eq 0 ]; then n=0; while curl -s "$S/api/activity" | grep -q "\"agent\":\"$a\""; do [ $n -eq 0 ] && echo "$a is busy, waiting (use --force to restart now)..."; n=$((n+1)); [ $n -gt 360 ] && { echo "$a still busy after 30 min, skipping"; continue 2; }; sleep 5; done; fi
      echo -n "$a: "; j -X POST "$S/api/agents/$a/restart" -d '{}'
    done ;;
  *) echo "usage: orcie create <name> [model] | ls | send <agent> <text> | dm <from> <to> <text> | log <agent> | shell <agent> | search <text> | doctor | add-external <name> | link-tmux <name> <session> | tmux-sessions | recreate <agent> | recreate-all | layoff <agent> [--confirm <agent>] [--no-archive] | drop-backup <agent> | set <agent> [--cpu N] [--memory 4g] [--disk 20g] [--model id] [--restart-ok] | check [agent] | stats | logs <agent> [n] | attach <agent> | restart [agent... | --all] [--force] | promises [agent]"; exit 1 ;;
esac
