#!/bin/bash
# orcie CLI (POC). Usage: orcie create|ls|send|dm|log|shell|rm ...
S="${ORCIE_SERVER:-http://127.0.0.1:8080}"
j() { curl -s -H 'content-type: application/json' "$@"; echo; }
enc() { node -e 'console.log(JSON.stringify(Object.fromEntries(process.argv.slice(1).map(a=>a.split(/=(.*)/s).slice(0,2)))))' "$@"; }
case "$1" in
  create) j -X POST "$S/agents" -d "$(enc name="$2" ${3:+model="$3"})" ;;
  ls) j "$S/agents" ;;
  send) j -X POST "$S/dm" -d "$(enc from=user to="$2" text="$3")" ;;
  dm) # operator acting as agent <from>: signs with the server secret (the agent listener derives the sender from the token)
    T=$(node -e 'const c=require("crypto");const s=require("fs").readFileSync(process.env.HOME+"/.orcie/server-secret","utf8").trim();console.log(c.createHmac("sha256",s).update("orcie-agent:"+process.argv[1]).digest("hex"))' "$2")
    curl -s -H 'content-type: application/json' -H "Authorization: Bearer $T" -X POST "${ORCIE_AGENT_SERVER:-http://127.0.0.1:8081}/dm" -d "$(enc to="$3" text="$4")"; echo ;;
  log) curl -s "$S/agents/$2/log" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).log.forEach(t=>console.log(`\n[${t.at}] ${t.from}: ${t.text}\n  -> ${t.reply}`)))' ;;
  shell) docker exec -it "orcie-$2" bash ;;
  search) curl -s "$S/api/search?q=$(node -e 'console.log(encodeURIComponent(process.argv[1]))' "$2")" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).results.forEach(r=>console.log(`${r.title} #${r.seq} ${r.from}: ${r.snippet.replace(/\[\[|\]\]/g,"*").replace(/\n/g," ")}`)))' ;;
  doctor) curl -s "$S/api/git?verify=1" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);console.log("git token file:",j.tokenFile?"present":"MISSING");let bad=0;j.agents.forEach(a=>{const ok=a.ok;if(!ok)bad++;console.log(`  ${a.name.padEnd(10)} mounted=${a.mounted} github=${a.githubUser||"NO ACCESS"}${ok?"":"   <- run: orcie recreate "+a.name}`)});(j.external||[]).forEach(n=>console.log(`  ${n.padEnd(10)} external agent (no container, not given the token)`));process.exit(bad?1:0)})' ;;
  link-tmux) j -X POST "$S/agents/tmux" -d "$(enc name="$2" session="$3")" ;;
  tmux-sessions) j "$S/api/tmux" ;;
  add-external) j -X POST "$S/agents/external" -d "$(enc name="$2")" ;;
  recreate) j -X POST "$S/api/agents/$2/recreate" ;;
  recreate-all) for a in $(curl -s "$S/agents" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).forEach(a=>console.log(a.name)))'); do echo -n "$a: "; j -X POST "$S/api/agents/$a/recreate" | head -c 80; echo; done ;;
  rm) # lay off: deletes the container and volume, keeps all conversation history; asks you to type the name unless --yes
    [ -n "$2" ] || { echo "usage: orcie rm <agent> [--yes]"; exit 1; }
    if [ "$3" != "--yes" ]; then printf 'This removes agent "%s" (container, volume, room membership). Conversation history is kept.\nType the agent name to confirm: ' "$2"; read -r ans; [ "$ans" = "$2" ] || { echo "cancelled"; exit 1; }; fi
    j -X DELETE "$S/agents/$2?confirm=$2" ;;
  check) # in-container checks: tools, auth, browser, GitHub, image, server reachability
    curl -s "$S/api/check${2:+?agent=$2}" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);let bad=0;for(const a of j.agents){console.log(a.agent+(a.ok?"  OK":"  PROBLEMS"));for(const c of a.checks){if(!c.ok)bad++;console.log("  "+(c.ok?"ok  ":"FAIL")+" "+c.name.padEnd(10)+c.detail)}}process.exit(bad?1:0)})' ;;
  stats) curl -s "$S/api/stats" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);console.log("agent".padEnd(14)+"kind".padEnd(10)+"busy".padEnd(6)+"convs".padEnd(7)+"sent".padEnd(7)+"promises".padEnd(10)+"cpu".padEnd(9)+"memory");for(const a of j.agents)console.log(a.name.padEnd(14)+a.kind.padEnd(10)+String(a.busy).padEnd(6)+String(a.conversations).padEnd(7)+String(a.messagesSent).padEnd(7)+String(a.activePromises).padEnd(10)+String(a.cpu??"-").padEnd(9)+(a.memory??"-"))})' ;;
  logs) docker logs --tail "${3:-100}" "orcie-$2" ;;
  attach) # chat with an agent from the terminal (Ctrl-D to leave)
    [ -n "$2" ] || { echo "usage: orcie attach <agent>"; exit 1; }; echo "chatting with $2 (Ctrl-D to leave)"
    while printf '%s> ' "you"; IFS= read -r line; do [ -z "$line" ] && continue; echo "...thinking"; curl -s -X POST "$S/dm" -H 'content-type: application/json' -d "$(enc to="$2" text="$line")" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);console.log("\n"+"'"$2"'"+"> "+(j.reply??j.error??"(no reply)")+"\n")})'; done; echo ;;
  promises) curl -s "$S/api/promises${2:+?agent=$2}" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).promises.forEach(p=>console.log(`#${p.id} ${p.agent} [${p.status}] ${p.text}`)))' ;;
  restart) # restart agent processes; waits until the agent is idle unless --force
    force=0; names=(); for a in "${@:2}"; do [ "$a" = "--force" ] && force=1 || names+=("$a"); done
    if [ "${names[0]}" = "--all" ] || [ ${#names[@]} -eq 0 ]; then names=($(curl -s "$S/agents" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>JSON.parse(s).filter(a=>!a.kind||a.kind==="claude").forEach(a=>console.log(a.name)))')); fi
    for a in "${names[@]}"; do
      if [ $force -eq 0 ]; then n=0; while curl -s "$S/api/activity" | grep -q "\"agent\":\"$a\""; do [ $n -eq 0 ] && echo "$a is busy, waiting (use --force to restart now)..."; n=$((n+1)); [ $n -gt 360 ] && { echo "$a still busy after 30 min, skipping"; continue 2; }; sleep 5; done; fi
      echo -n "$a: "; j -X POST "$S/api/agents/$a/restart" -d '{}'
    done ;;
  *) echo "usage: orcie create <name> [model] | ls | send <agent> <text> | dm <from> <to> <text> | log <agent> | shell <agent> | search <text> | doctor | add-external <name> | link-tmux <name> <session> | tmux-sessions | recreate <agent> | recreate-all | rm <agent> [--yes] | check [agent] | stats | logs <agent> [n] | attach <agent> | restart [agent... | --all] [--force] | promises [agent]"; exit 1 ;;
esac
