#!/bin/bash
# git credential helper: serves the shared token (mounted read-only at /gitcreds) for github.com over HTTPS.
# Read at use time, so rotating ~/.orcie/git/token on the host updates every agent immediately.
[ "$1" = "get" ] || exit 0
host=""; while IFS='=' read -r k v; do [ "$k" = "host" ] && host="$v"; done
[ "$host" = "github.com" ] && [ -r /gitcreds/token ] || exit 0
echo "username=x-access-token"; echo "password=$(cat /gitcreds/token)"
