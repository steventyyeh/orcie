#!/bin/bash
# Usage: orcie-dm <agent> "message"   (routes through the orcie server)
[ $# -ge 2 ] || { echo "usage: orcie-dm <agent> <message>" >&2; exit 1; }
to="$1"; shift
curl -s --max-time 900 -X POST "${ORCIE_SERVER:-http://host.docker.internal:8080}/dm" \
  -H 'content-type: application/json' -H "Authorization: Bearer ${ORCIE_AGENT_TOKEN}" \
  -d "$(node -e 'console.log(JSON.stringify({to:process.argv[1],text:process.argv[2]}))' "$to" "$*")" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);console.log(j.reply??s)})'
